# ink-ms-ai-assistant

# MongoDB: catálogo de ejercicios, base de conocimiento del chatbot, banco de
# preguntas, conversaciones y quices generados.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=inclusport_training_ia

# URIs que se prueban si la principal falla (separadas por coma). Evita el caso
# de arrancar en local con la URI de Docker o con credenciales en una instancia
# sin autenticación.
MONGODB_URI_ALTERNATIVAS=mongodb://localhost:27017/,mongodb://admin:admin123@localhost:27017/

# Microservicios
AUTH_SERVICE_URL=http://localhost:3001
USERS_SERVICE_URL=http://localhost:3002
SPORTS_SERVICE_URL=http://localhost:3003
ACCESSIBILITY_SERVICE_URL=http://localhost:3004
REPORTS_SERVICE_URL=http://localhost:3006

# LLM OPCIONAL
# El asistente responde, genera rutinas, recomienda eventos y crea quices sin
# LLM gracias al motor local. Si configuras un proveedor, se usa para redactar
# respuestas más ricas y vuelve al motor local si falla.
LLM_ENABLED=true
LLM_API_KEY=
LLM_TIMEOUT=25

# Tras un fallo del proveedor se deja de intentar durante estos segundos, para
# que el chat no espere el timeout completo en cada petición.
LLM_COOLDOWN_SEGUNDOS=120

# El prefijo de la clave determina el proveedor y, si hace falta, se corrigen
# modelo y URL automáticamente.
#
# xAI (clave xai-)
LLM_MODEL=grok-4.5
LLM_API_URL=https://api.x.ai/v1/chat/completions
#
# Groq (clave gsk_)
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
#
# OpenAI (clave sk-)
# LLM_MODEL=gpt-4o-mini
# LLM_API_URL=https://api.openai.com/v1/chat/completions
