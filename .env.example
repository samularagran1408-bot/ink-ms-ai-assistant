# ink-ms-ai-assistant — LLM (xAI Grok o Groq)

# Clave gsk_ → Groq (api.groq.com)
# Clave xai- → Grok xAI (api.x.ai)
GROK_API_KEY=
GROK_MODEL=llama-3.3-70b-versatile
GROK_API_URL=https://api.groq.com/openai/v1/chat/completions

# Para xAI Grok descomenta y ajusta:
# GROK_MODEL=grok-4.5
# GROK_API_URL=https://api.x.ai/v1/chat/completions

# MongoDB (base de conocimiento del chatbot)
MONGODB_URI=mongodb://admin:admin123@localhost:27017/
MONGODB_DB=inclusport_training_ia

# Microservicios
AUTH_SERVICE_URL=http://localhost:3001
USERS_SERVICE_URL=http://localhost:3002
SPORTS_SERVICE_URL=http://localhost:3003
